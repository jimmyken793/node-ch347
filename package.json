{
  "name": "node-ch347",
  "version": "0.0.1",
  "description": "Node.js library for CH347 USB interface - GPIO, SPI flash programming, and UART",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/examples",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build",
    "example": "node dist/examples/basic.js"
  },
  "keywords": [
    "ch347",
    "usb",
    "gpio",
    "spi",
    "uart",
    "flash",
    "programmer",
    "embedded",
    "hardware"
  ],
  "author": "",
  "license": "Unlicense",
  "dependencies": {
    "usb": "^2.14.0"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ]
}
