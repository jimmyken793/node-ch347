{
  "name": "node-ch347",
  "version": "0.0.3",
  "description": "Node.js library for CH347 USB interface - GPIO, SPI flash programming, and UART",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/examples",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build",
    "example": "node dist/examples/basic.js",
    "test:wch-dll": "node dist/examples/test-wch-dll.js",
    "test:wch-backend": "node dist/examples/test-wch-backend.js"
  },
  "keywords": [
    "ch347",
    "usb",
    "gpio",
    "spi",
    "uart",
    "flash",
    "programmer",
    "embedded",
    "hardware"
  ],
  "author": "",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyken793/node-ch347.git"
  },
  "homepage": "https://github.com/jimmyken793/node-ch347#readme",
  "bugs": {
    "url": "https://github.com/jimmyken793/node-ch347/issues"
  },
  "dependencies": {
    "usb": "^2.14.0"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ]
}
